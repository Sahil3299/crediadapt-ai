# MongoDB Atlas connection string. Add your deployment IP in Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.5akxduo.mongodb.net/crediadapt?retryWrites=true&w=majority
MONGODB_DB_NAME=crediadapt

# Use long, random values in real environments; never commit your .env file.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7

# Comma-separated browser origins. Add the exact Vercel origin in Render.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Set true on Render/HTTPS so the refresh cookie works cross-site from Vercel.
COOKIE_SECURE=false
# Optional absolute path to a TrueType font with ₹ support (e.g. DejaVu Sans).
CREDIADAPT_PDF_FONT=
GOOGLE_API_KEY=
